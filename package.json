{
  "name": "refine-cycle-openclaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An OpenClaw plugin that learns from the agent's own repeated failures.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "build": "npx -y -p typescript@5.9 -p @types/node@24 tsc -p tsconfig.build.json"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "install": {
      "minHostVersion": ">=2026.9.5"
    },
    "compat": {
      "pluginApi": ">=2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ]
}
