{
  "name": "refine-cycle",
  "version": "1.0.0",
  "type": "module",
  "description": "An OpenClaw plugin that learns from the agent's own repeated failures.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bergschloss/Refine-Cycle-for-OpenClaw.git"
  },
  "homepage": "https://github.com/Bergschloss/Refine-Cycle-for-OpenClaw#readme",
  "bugs": {
    "url": "https://github.com/Bergschloss/Refine-Cycle-for-OpenClaw/issues"
  },
  "keywords": ["openclaw", "openclaw-plugin", "agent", "lessons", "tool-failures"],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "install": {
      "minHostVersion": ">=2026.9.5"
    },
    "compat": {
      "pluginApi": ">=2026.9.5",
      "minGatewayVersion": "2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  },
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
