# LF for everything a deploy or an install takes, even from a Windows checkout with
# core.autocrlf=true: git archive and git checkout apply these, so the shipped files
# are byte for byte the ones in the repository.
src/** text eol=lf
dist/** text eol=lf
test/** text eol=lf
# The package's root files (package.json "files"), which an install or a deploy takes too.
package.json text eol=lf
openclaw.plugin.json text eol=lf
README.md text eol=lf
LICENSE text eol=lf
*.png binary

